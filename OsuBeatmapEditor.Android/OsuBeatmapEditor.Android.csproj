<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Android host for the sobe editor.

    Targets net8.0-android on purpose: the pinned osu!framework release (2026.527.0) and the Game project are
    both .NET 8. Only unreleased osu!framework master has moved to .NET 10, so we must NOT use the .NET 10
    sample as the template (that mismatch is what broke the earlier on-device Termux attempt).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OsuBeatmapEditor.Android</RootNamespace>
    <AssemblyName>OsuBeatmapEditor.Android</AssemblyName>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <!-- The Infinix Hot 50 is ARM64; building a single ABI keeps the APK small and the build fast. -->
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <ApplicationId>io.github.akrasia524.sobe</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.9.69-android.1</ApplicationDisplayVersion>
    <!-- Settings required by osu!framework on Android (copied from the framework's osu.Framework.Android.props). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidHttpClientHandlerType>Xamarin.Android.Net.AndroidMessageHandler</AndroidHttpClientHandlerType>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <NoWarn>$(NoWarn);XA4218</NoWarn>
    <!-- The repo-wide Directory.Build.props points at a Windows app manifest; meaningless on Android. -->
    <ApplicationManifest></ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- .NET 8 Android is past Microsoft's support window; the pinned osu!framework still requires it. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>
  <!-- Debug builds are signed with a fixed, committed debug key (the standard public Android debug key, password
       "android") so every CI build has the SAME signature and can be installed over the previous one without
       uninstalling. It is NOT a release key and must never be used to publish the app. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>debug.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>android</AndroidSigningKeyPass>
    <AndroidSigningStorePass>android</AndroidSigningStorePass>
  </PropertyGroup>
  <!-- Release builds: no IL trimming for now. osu!framework relies on reflection (DI, bindables), so trimming
       is only enabled later, after it has been verified on a real device. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OsuBeatmapEditor.Game\OsuBeatmapEditor.Game.csproj" />
    <ProjectReference Include="..\OsuBeatmapEditor.Resources\OsuBeatmapEditor.Resources.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Framework.Android" Version="2026.527.0" />
  </ItemGroup>
</Project>
